# PostgreSQL connection string for local development or Neon.
# Keep credentials out of Git and provide this value via .env.local or the host environment.
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# WebAuthn relying-party configuration. RP ID is a hostname without scheme/port;
# origin is the exact public origin. These localhost values are for development only.
# Set stable HTTPS values through the production environment; do not invent or commit secrets.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_RP_NAME=Wishlist

# Versioned recovery-code HMAC peppers, supplied by the deployment secret manager.
# Each value must be an independently generated, base64url-encoded secret of at least 32 bytes.
# Keep old versions available while recovery-code rows still reference them.
RECOVERY_CODE_PEPPERS={"1":"<base64url-encoded-32-byte-pepper>"}
RECOVERY_CODE_ACTIVE_PEPPER_VERSION=1
