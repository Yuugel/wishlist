# Local development template. For Neon/Vercel, set the same variable names in
# the provider environment and replace every placeholder there, never in Git.
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# Local WebAuthn exception. Production requires an explicitly chosen stable RP
# ID and its exact HTTPS origin. Do not use or derive a random Preview URL.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_RP_NAME=Wishlist

# Vercel Preview passkeys are fail-closed by default. Set exactly "true" only
# with a fixed controlled test domain/RP ID and isolated Preview secrets/data.
WEBAUTHN_PREVIEW_ENABLED=false

# Versioned recovery-code HMAC peppers, supplied by the deployment secret manager.
# Each placeholder represents an independently generated Base64url secret of at
# least 32 bytes. Retain old versions while database rows still reference them.
RECOVERY_CODE_PEPPERS={"1":"<base64url-encoded-32-byte-pepper>"}
RECOVERY_CODE_ACTIVE_PEPPER_VERSION=1
